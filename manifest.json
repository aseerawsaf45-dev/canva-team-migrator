{
  "manifest_version": 3,
  "name": "CanvaPortal — Team Design Migrator",
  "version": "3.0.0",
  "description": "Automatically detect all Canva teams, switch teams, select all designs, and migrate them into a new project folder.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.canva.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.canva.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.canva.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
